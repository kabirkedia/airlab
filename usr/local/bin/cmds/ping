#!/bin/bash

# Exit on error, undefined variables, and pipe failures
set -euo pipefail

# Shared SSH-address resolution (--address via robots.yaml, robot.conf fallback)
source "$(dirname "$0")/_lib/resolve.sh"

# Color codes for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Logging functions
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Function to print usage information
show_usage() {
    echo -e "${YELLOW}Usage:${NC}"
    echo "  airlab ping <robot_name>"
    echo
    echo -e "${YELLOW}Arguments:${NC}"
    echo "  <robot_name>              Name of the robot to ping (must be defined in robot.conf)"
    echo
    echo -e "${YELLOW}Options:${NC}"
    echo "  --address <name>          Use a named network address from robots.yaml (e.g. internet)"
    echo "  --help                    Show this help message"
    echo
    echo -e "${YELLOW}Examples:${NC}"
    echo "  airlab ping mt001         # Ping the robot mt001"
}

main() {
    if [[ $# -eq 0 || "$1" == "--help" ]]; then
        show_usage
        exit 0
    fi

    ROBOT_NAME="$1"
    ADDRESS=""
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --address) ADDRESS="$2"; shift ;;
            --address=*) ADDRESS="${1#--address=}" ;;
            *) log_error "Invalid option: $1"; show_usage; exit 1 ;;
        esac
        shift
    done

    # Check for robot configuration
    ROBOT_CONF="$AIRLAB_PATH/robot/robot.conf"
    if [[ ! -f "$ROBOT_CONF" ]]; then
        log_error "Robot configuration file not found at '$ROBOT_CONF'"
        exit 1
    fi

    # Resolve the SSH address (registry-aware; robot.conf fallback). Format: user@host,
    # user@host:port, or ssh://user@host:port.
    ROBOT_SSH_ADDRESS=$(resolve_ssh_address "$ROBOT_NAME" "$ADDRESS")
    if [[ -z "$ROBOT_SSH_ADDRESS" ]]; then
        log_error "Robot '$ROBOT_NAME'${ADDRESS:+ (address '$ADDRESS')} not found in robots.yaml or $ROBOT_CONF"
        exit 1
    fi

    # Extract hostname: strip user@ prefix, then strip :port suffix if present
    ROBOT_HOST="${ROBOT_SSH_ADDRESS#*@}"
    ROBOT_HOST="${ROBOT_HOST%%:*}"

    log_info "Pinging $ROBOT_NAME ($ROBOT_HOST)..."
    ping "$ROBOT_HOST"
}

# Run main function
main "$@"
